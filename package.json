{
  "name": "nailbook",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @nailbook/db exec prisma generate",
    "db:migrate": "pnpm --filter @nailbook/db exec prisma migrate dev",
    "db:push": "pnpm --filter @nailbook/db exec prisma db push",
    "db:studio": "pnpm --filter @nailbook/db exec prisma studio",
    "db:migrate:deploy": "pnpm --filter @nailbook/db exec prisma migrate deploy",
    "prelaunch": "bash scripts/pre-launch-check.sh"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
