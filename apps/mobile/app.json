{
  "expo": {
    "name": "NailBook",
    "slug": "nailbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nailbook",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FAF9F7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nailbook.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F7"
      },
      "package": "com.nailbook.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NailBook needs access to your photos to upload portfolio images."
        }
      ]
    ]
  }
}
