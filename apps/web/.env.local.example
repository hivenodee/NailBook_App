# ============================================
# NailBook Environment Variables
# ============================================
# Copy this file to .env.local and fill in your credentials.
# Required vars are marked [REQUIRED], optional ones [OPTIONAL].
# The app gracefully degrades when optional services are not configured.

# --- Database [REQUIRED] ---
# Get from: https://console.neon.tech/ (or any PostgreSQL provider)
DATABASE_URL=postgresql://user:password@host:5432/nailbook

# --- Application [REQUIRED] ---
# Your public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth: Clerk [REQUIRED] ---
# Get from: https://dashboard.clerk.com/ -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Payments: Stripe [REQUIRED] ---
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...
# Get from: https://dashboard.stripe.com/webhooks (after creating endpoint)
# Local dev: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Events needed: checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=whsec_...
# Test card: 4242 4242 4242 4242 (any future exp, any CVC)

# --- Email: Resend [OPTIONAL] ---
# Get from: https://resend.com/api-keys
# Without this: emails are logged to the server console instead of sent
RESEND_API_KEY=
EMAIL_FROM=bookings@yourdomain.com

# --- SMS: Twilio [OPTIONAL] ---
# Get from: https://console.twilio.com/
# Without this: SMS messages are logged to the server console instead of sent
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Cache: Upstash Redis [OPTIONAL but RECOMMENDED] ---
# Get from: https://console.upstash.com/ -> REST API section
# Without this: no rate limiting, no availability caching, no background jobs
REDIS_URL=
REDIS_TOKEN=

# --- Storage: Cloudflare R2 [OPTIONAL] ---
# Without this: portfolio uploads won't work
#
# Setup:
# 1. Create a Cloudflare account -> R2 -> Create bucket (e.g. "nailbook-media")
# 2. Bucket Settings -> Public access -> Enable (gives you a public URL like https://pub-xxx.r2.dev)
#    OR connect a custom domain (e.g. media.yourdomain.com)
# 3. Bucket Settings -> CORS policy -> Add rule:
#    Allowed Origins: http://localhost:3000 (add your production URL later)
#    Allowed Methods: GET, PUT
#    Allowed Headers: Content-Type
# 4. R2 -> Manage R2 API Tokens -> Create API token:
#    Permissions: Object Read & Write
#    Specify bucket: your bucket name
#    Copy the Access Key ID and Secret Access Key
# 5. Your Account ID is in the Cloudflare dashboard URL: dash.cloudflare.com/<ACCOUNT_ID>
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nailbook-media
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# --- Monitoring: Sentry [OPTIONAL] ---
# Get from: https://sentry.io/ -> Project Settings -> Client Keys
# Without this: no error monitoring (errors still logged to console)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Push Notifications [OPTIONAL] ---
# Expo push token for mobile notifications
EXPO_ACCESS_TOKEN=
# Web push VAPID key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
