# Database
# 1. Provision a PostgreSQL database (Neon, Supabase, Railway, etc.)
# 2. Copy the connection string
DATABASE_URL=postgresql://user:password@host:5432/nailbook

# Clerk — Authentication
# 1. Create a Clerk application at https://dashboard.clerk.com
# 2. Copy the publishable key and secret key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Stripe — Payments (Test Mode)
# 1. Create a Stripe account at https://dashboard.stripe.com/register
# 2. Toggle to "Test mode" in the dashboard
# 3. Copy your test API keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook (local development)
# 1. Install Stripe CLI: https://stripe.com/docs/stripe-cli
# 2. Run: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# 3. Copy the webhook signing secret (whsec_...) printed by the CLI
STRIPE_WEBHOOK_SECRET=whsec_...

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Test card number: 4242 4242 4242 4242 (any future exp, any CVC)

# Email (Resend — optional)
# 1. Create a Resend account at https://resend.com
# 2. Create an API key from the dashboard
# 3. Verify your sender domain in Resend
# If not set, emails are logged to the dev server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=bookings@yourdomain.com

# SMS (Twilio — optional)
# 1. Create a Twilio account at https://www.twilio.com/try-twilio
# 2. Get your Account SID and Auth Token from the Twilio Console
# 3. Buy or verify a phone number for sending SMS
# If not set, SMS messages are logged to the dev server console instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Redis / Upstash (Availability caching — optional)
# 1. Create a free Redis DB at https://console.upstash.com
# 2. Copy the REST URL and token from the dashboard
# If not set, availability caching is disabled (API still works, just uncached).
REDIS_URL=
REDIS_TOKEN=

# Cloudflare R2 (Portfolio uploads — optional)
# 1. Create a Cloudflare account → R2 → Create bucket (e.g. "nailbook-media")
# 2. Bucket Settings → Public access → Enable (gives you a public URL like https://pub-xxx.r2.dev)
#    OR connect a custom domain (e.g. media.yourdomain.com)
# 3. Bucket Settings → CORS policy → Add rule:
#    Allowed Origins: http://localhost:3000 (add your production URL later)
#    Allowed Methods: GET, PUT
#    Allowed Headers: Content-Type
# 4. R2 → Manage R2 API Tokens → Create API token:
#    Permissions: Object Read & Write
#    Specify bucket: your bucket name
#    Copy the Access Key ID and Secret Access Key
# 5. Your Account ID is in the Cloudflare dashboard URL: dash.cloudflare.com/<ACCOUNT_ID>
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nailbook-media
R2_PUBLIC_URL=https://pub-xxx.r2.dev
