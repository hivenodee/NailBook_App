# Stripe — Test Mode
# 1. Create a Stripe account at https://dashboard.stripe.com/register
# 2. Toggle to "Test mode" in the dashboard
# 3. Copy your test API keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook (local development)
# 1. Install Stripe CLI: https://stripe.com/docs/stripe-cli
# 2. Run: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# 3. Copy the webhook signing secret (whsec_...) printed by the CLI
STRIPE_WEBHOOK_SECRET=whsec_...

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Test card number: 4242 4242 4242 4242 (any future exp, any CVC)

# Email (Postmark)
# 1. Create a Postmark account at https://postmarkapp.com
# 2. Create a "Server" and copy the API token
# 3. Verify your sender domain or email in Postmark
# If not set, emails are logged to the dev server console instead of sent.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=bookings@yourdomain.com
