# Database
DATABASE_URL=postgresql://user:password@host:5432/nailbook

# Redis (required for worker — BullMQ job queues)
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=

# Stripe
STRIPE_SECRET_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=bookings@yourdomain.com

# Cloudflare R2 (for CSV export uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nailbook-media
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Error tracking (optional)
SENTRY_DSN=
