generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Tenancy ───────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  phone     String?
  avatarUrl String?
  role      UserRole @default(CLIENT)

  provider Provider?

  appointments    Appointment[]
  sentMessages    Message[]       @relation("MessageSender")
  favoriteProviders FavoriteProvider[]
  accountEvents   AccountActivityEvent[]
  pushTokens       PushToken[]
  notificationLogs NotificationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clerkId])
}

enum UserRole {
  CLIENT
  PROVIDER
  ADMIN
}

enum ProviderCategory {
  NAILS
  HAIR
  ESTHETICS
  BROWS_LASHES
  MASSAGE
  OTHER
}

model Provider {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id])
  slug        String  @unique
  businessName String
  bio         String?
  category       ProviderCategory @default(NAILS)
  locationAddress String?
  locationLat Float?
  locationLng Float?
  coverImageUrl String?
  instagramUrl  String?
  tiktokUrl     String?
  isVerified    Boolean @default(false)

  // Payment preferences
  acceptsCard    Boolean @default(true)
  acceptsApplePay Boolean @default(false)
  acceptsGooglePay Boolean @default(false)
  acceptsCashAppPay Boolean @default(false)
  acceptsCash    Boolean @default(true)

  // Booking preferences
  instantBook    Boolean @default(true)
  requireInspirationPhoto Boolean @default(false)
  arrivalGraceMinutes Int @default(15)
  timezone        String  @default("America/New_York")

  // Books open/close
  booksOpen          Boolean   @default(true)
  booksOpenAt        DateTime? // scheduled time to open books (null = no schedule)
  bookingWindowDays  Int       @default(30) // how many days ahead clients can book

  // Buffer between appointments
  bufferMinutes      Int       @default(0)

  // Cancellation policy
  cancellationHours Int @default(24)
  noShowFeePercent  Int @default(100)

  // Stripe
  stripeAccountId String?

  services        Service[]
  coupons         Coupon[]
  availabilityRules AvailabilityRule[]
  timeOffs        TimeOff[]
  appointments    Appointment[]
  threads         Thread[]
  mediaAssets     MediaAsset[]
  payments        Payment[]
  payouts         Payout[]
  exportJobs      ExportJob[]
  favoritedBy     FavoriteProvider[]
  providerClients ProviderClient[]
  messageTemplates MessageTemplate[]
  waitlistEntries  WaitlistEntry[]
  feedback         Feedback[]
  reminderSettings ReminderSetting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([locationLat, locationLng])
}

model FavoriteProvider {
  id         String   @id @default(cuid())
  userId     String
  providerId String
  user       User     @relation(fields: [userId], references: [id])
  provider   Provider @relation(fields: [providerId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, providerId])
}

// ─── Provider Clients ─────────────────────────────────────

model ProviderClient {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  email      String
  name       String?
  phone      String?
  notes      String?  // provider-only internal notes

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, email])
  @@index([providerId])
}

// ─── Catalog ───────────────────────────────────────────────

model Service {
  id          String  @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id])
  name        String
  description String?
  priceInCents Int
  durationMinutes Int
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  // Deposit settings
  depositType    DepositType @default(NONE)
  depositValue   Int         @default(0) // cents for FLAT, percentage for PERCENT

  addOns           AddOn[]
  addOnGroups      AddOnGroup[]
  appointments     Appointment[]
  coupons          Coupon[]
  waitlistEntries  WaitlistEntry[]
  intakeQuestions  IntakeQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
}

enum DepositType {
  NONE
  FLAT
  PERCENT
}

enum GroupSelectionRule {
  OPTIONAL        // pick any or none
  EXACTLY_ONE     // client must pick exactly 1 (radio)
  AT_LEAST_ONE    // client must pick 1+ (checkbox, min 1)
}

model AddOnGroup {
  id         String             @id @default(cuid())
  serviceId  String
  service    Service            @relation(fields: [serviceId], references: [id])
  name       String
  sortOrder  Int                @default(0)
  rule       GroupSelectionRule  @default(OPTIONAL)

  addOns     AddOn[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([serviceId])
}

model AddOn {
  id          String  @id @default(cuid())
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id])
  name        String
  priceInCents Int
  durationMinutes Int @default(0)
  isActive    Boolean @default(true)

  groupId     String?
  group       AddOnGroup? @relation(fields: [groupId], references: [id])
  isMandatory Boolean     @default(false)
  sortOrder   Int         @default(0)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
}

// ─── Scheduling ────────────────────────────────────────────

model AvailabilityRule {
  id         String  @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  dayOfWeek  Int     // 0=Sunday, 6=Saturday
  startTime  String  // "09:00" (HH:mm)
  endTime    String  // "17:00" (HH:mm)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
}

model TimeOff {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  startDate  DateTime
  endDate    DateTime
  reason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
  @@index([startDate, endDate])
}

// ─── Appointments ──────────────────────────────────────────

model Appointment {
  id           String            @id @default(cuid())
  providerId   String
  provider     Provider          @relation(fields: [providerId], references: [id])
  clientId     String
  client       User              @relation(fields: [clientId], references: [id])
  serviceId    String
  service      Service           @relation(fields: [serviceId], references: [id])
  status       AppointmentStatus @default(DRAFT)

  startTime    DateTime
  endTime      DateTime
  totalInCents    Int
  depositInCents  Int             @default(0)
  discountInCents Int             @default(0)
  couponId        String?
  coupon          Coupon?         @relation(fields: [couponId], references: [id])

  // Provider client profile
  providerClientId String?
  providerClient   ProviderClient? @relation(fields: [providerClientId], references: [id])

  // Client info (for web bookings without account)
  clientName   String?
  clientEmail  String?
  clientPhone  String?

  // Provider notes
  notes        String?
  isNewClient  Boolean @default(false)
  bookedFromWaitlist Boolean @default(false)

  // Inspiration photo
  inspirationUrl String?

  // Client self-service token
  manageToken    String?  @unique

  // Recurring booking fields
  recurrenceGroupId  String?
  recurrenceIndex    Int?

  // Stripe
  stripeSessionId   String?
  stripePaymentIntentId String?

  addOns           AddOn[]
  events           AppointmentEvent[]
  payments         Payment[]
  thread           Thread?
  feedback         Feedback?
  notificationLogs NotificationLog[]
  intakeResponses  IntakeResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
  @@index([clientId])
  @@index([startTime])
  @@index([providerId, startTime])
  @@index([status])
}

enum AppointmentStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model AppointmentEvent {
  id            String   @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  type          String   // e.g. "created", "confirmed", "cancelled", "rescheduled", "payment_received"
  actorId       String?  // userId who triggered, null for system
  actorType     String?  // "client", "provider", "system"
  metadata      Json?    // flexible extra data
  createdAt     DateTime @default(now())

  @@index([appointmentId])
}

// ─── Payments ──────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  providerId    String
  provider      Provider      @relation(fields: [providerId], references: [id])
  appointmentId String
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  amountInCents Int
  type          PaymentType
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod

  stripePaymentIntentId String?
  stripeRefundId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
  @@index([appointmentId])
  @@index([appointmentId, type])
}

enum PaymentType {
  DEPOSIT
  FULL
  BALANCE
  REFUND
  TIP
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  GOOGLE_PAY
  CASH_APP_PAY
  CASH
}

model Payout {
  id            String       @id @default(cuid())
  providerId    String
  provider      Provider     @relation(fields: [providerId], references: [id])
  amountInCents Int
  status        PayoutStatus @default(INITIATED)
  stripePayoutId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
}

enum PayoutStatus {
  INITIATED
  PROCESSING
  COMPLETED
  FAILED
}

// ─── Messaging ─────────────────────────────────────────────

model Thread {
  id            String   @id @default(cuid())
  providerId    String
  provider      Provider @relation(fields: [providerId], references: [id])
  appointmentId String   @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
}

model Message {
  id       String  @id @default(cuid())
  threadId String
  thread   Thread  @relation(fields: [threadId], references: [id])
  senderId String
  sender   User    @relation("MessageSender", fields: [senderId], references: [id])
  body     String
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([threadId])
}

// ─── Intake Forms ─────────────────────────────────────────

model IntakeQuestion {
  id         String   @id @default(cuid())
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  label      String   // "Do you have any allergies?"
  type       String   // TEXT, SELECT, CHECKBOX
  options    Json?    // ["Gel", "Acrylic", "Dip"] for SELECT/CHECKBOX
  isRequired Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  responses IntakeResponse[]
  @@index([serviceId])
}

model IntakeResponse {
  id            String         @id @default(cuid())
  appointmentId String
  appointment   Appointment    @relation(fields: [appointmentId], references: [id])
  questionId    String
  question      IntakeQuestion @relation(fields: [questionId], references: [id])
  answer        String         // JSON string for checkbox arrays
  createdAt     DateTime       @default(now())

  @@unique([appointmentId, questionId])
  @@index([appointmentId])
}

// ─── Feedback & Reviews ────────────────────────────────────

model Feedback {
  id              String      @id @default(cuid())
  appointmentId   String      @unique
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  providerId      String
  provider        Provider    @relation(fields: [providerId], references: [id])
  rating          Int?        // 1-5, optional
  body            String      // free text, required
  isPublic        Boolean     @default(false)
  createdAt       DateTime    @default(now())

  @@index([providerId])
  @@index([providerId, isPublic])
}

// ─── Media ─────────────────────────────────────────────────

model MediaAsset {
  id         String    @id @default(cuid())
  providerId String
  provider   Provider  @relation(fields: [providerId], references: [id])
  type       MediaType
  url        String
  thumbnailUrl String?
  mimeType   String
  sizeBytes  Int
  sortOrder  Int       @default(0)
  isHidden   Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([providerId])
}

enum MediaType {
  PHOTO
  VIDEO
}

// ─── Logs ──────────────────────────────────────────────────

model AccountActivityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // "login", "password_change", "email_change", etc.
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Coupons ──────────────────────────────────────────────

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id          String     @id @default(cuid())
  providerId  String
  provider    Provider   @relation(fields: [providerId], references: [id])
  code        String     // stored UPPERCASE
  type        CouponType
  value       Int        // percent (1-100) or cents
  expiresAt   DateTime?
  maxUses     Int?       // null = unlimited
  usedCount   Int        @default(0)
  isActive    Boolean    @default(true)

  services     Service[]
  appointments Appointment[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([providerId, code])
  @@index([providerId])
}

// ─── Exports ───────────────────────────────────────────────

model ExportJob {
  id         String       @id @default(cuid())
  providerId String
  provider   Provider     @relation(fields: [providerId], references: [id])
  type       ExportType
  status     ExportStatus @default(PENDING)
  fileUrl    String?
  content    String?      @db.Text
  error      String?
  startDate  DateTime?
  endDate    DateTime?

  createdAt  DateTime @default(now())
  completedAt DateTime?

  @@index([providerId])
}

enum ExportType {
  CLIENTS
  APPOINTMENTS
  TRANSACTIONS
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── Message Templates ───────────────────────────────────

enum MessageTemplateType {
  BOOKING_CONFIRMATION
  BOOKING_NOTIFICATION
  CANCELLATION
  COMPLETION
  REMINDER
  FOLLOWUP
  WAITLIST_AVAILABLE
  WAITLIST_JOINED
  BALANCE_REQUEST
  TIP_REQUEST
}

model MessageTemplate {
  id           String              @id @default(cuid())
  providerId   String
  provider     Provider            @relation(fields: [providerId], references: [id])
  type         MessageTemplateType
  emailSubject String?
  emailBody    String?
  smsBody      String?
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([providerId, type])
  @@index([providerId])
}

// ─── Waitlist ────────────────────────────────────────────

enum WaitlistEntryStatus {
  ACTIVE
  AVAILABLE   // slot opened, awaiting provider approval
  NOTIFIED
  BOOKED
  EXPIRED
  CANCELLED
}

enum WaitlistTimePreference {
  ANY
  MORNING
  AFTERNOON
  EVENING
}

model WaitlistEntry {
  id              String                  @id @default(cuid())
  providerId      String
  provider        Provider                @relation(fields: [providerId], references: [id])
  serviceId       String?
  service         Service?                @relation(fields: [serviceId], references: [id])
  status          WaitlistEntryStatus     @default(ACTIVE)
  targetDate      DateTime
  targetTime      DateTime?               // specific slot time (null = day-level waitlist)
  timePreference  WaitlistTimePreference  @default(ANY)
  clientName      String
  clientEmail     String
  clientPhone     String?
  lastNotifiedAt  DateTime?
  notifyCount     Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([providerId, clientEmail, targetDate, targetTime])
  @@index([providerId, targetDate, status])
  @@index([providerId])
}

// ─── Push Notifications ──────────────────────────────────

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  Platform
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
}

enum Platform {
  IOS
  ANDROID
  WEB
}

model NotificationLog {
  id            String              @id @default(cuid())
  recipientId   String
  recipient     User                @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  templateType  MessageTemplateType
  channel       NotificationChannel
  status        NotificationStatus  @default(PENDING)
  title         String?
  body          String
  metadata      Json?
  sentAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  retryCount    Int                 @default(0)
  createdAt     DateTime            @default(now())

  @@index([recipientId])
  @@index([appointmentId])
  @@index([status])
  @@index([createdAt])
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

model ReminderSetting {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  hoursBefore Int
  channels   NotificationChannel[]
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([providerId, hoursBefore])
  @@index([providerId])
}
